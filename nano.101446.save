# ─────────────────── Symboles de devise (Unicode) ───────────────────
# Vrais symboles Unicode reconnus pour chaque ticker (source : recherches
# web — yonilevy/crypto-currency-symbols, unicode-explorer, Wikipedia).
# Chaque devise a sa propre icône, uniformément dans tous les menus.
def sym(ticker: str) -> str:
    """Icône monochrome d'une devise ou d'un couple actif/réseau."""
    legacy = {"polygon": "POL", "avalanche": "AVAX", "arbitrum": "ETH",
              "optimism": "ETH"}
    return asset_icon(legacy.get(str(ticker).lower(), ticker))


def icon_cell(value: str, width: int = 2) -> str:
    """Colonne d'icône stable, indépendamment de la largeur Unicode."""
    return pad_display(sym(value), width)


def wallet_icon(info: dict) -> str:
    return sym(info.get("asset_id") or info.get("token") or
               info.get("asset") or info.get("network"))


# ── Alignement visuel des icônes (largeur d'affichage réelle) ──
# Les terminaux affichent certains glyphes sur 2 colonnes (CJK, emoji astraux,
# paires de drapeaux, et combinaisons avec sélecteur de variante U+FE0F).
# On calcule la largeur d'affichage pour aligner les icônes à droite de façon
# identique dans toutes les langues, au lieu de compter les caractères (len()).
import unicodedata

def disp_width(s: str) -> int:
    """Largeur d'affichage réelle d'une chaîne dans un terminal monospace."""
    chars = list(s)
    w = 0
    i = 0
    n = len(chars)
    while i < n:
        c = chars[i]
        o = ord(c)
        # Sélecteur de variante (U+FE0F) : largeur nulle, combine avec le précédent
        if o == 0xFE0F:
            i += 1
            continue
        # Paire de drapeaux (Regional Indicators U+1F1E6..U+1F1FF) -> 2 colonnes
        if 0x1F1E6 <= o <= 0x1F1FF:
            if i + 1 < n and 0x1F1E6 <= ord(chars[i + 1]) <= 0x1F1FF:
                w += 2
                i += 2
                continue
            w += 1
            i += 1
            continue
        # Emoji de plan astral (>= U+10000) : 2 colonnes
        if o > 0xFFFF:
            w += 2
            i += 1
            continue
        # Caractère suivi d'un sélecteur de variante -> traité comme emoji (2 colonnes)
        if i + 1 < n and ord(chars[i + 1]) == 0xFE0F:
            w += 2
            i += 2
            continue
        # Est-asiatique large / pleine largeur : 2 colonnes
        if unicodedata.east_asian_width(c) in ("W", "F"):
            w += 2
        else:
            w += 1
        i += 1
    return w


def pad_display(text: str, width: int) -> str:
    """Complète `text` avec des espaces jusqu'à `width` colonnes d'affichage."""
    pad = width - disp_width(text)
    return text + (" " * pad if pad > 0 else "")


# Largeurs cibles d'alignement (colonnes d'affichage)
# PAD_OPT doit couvrir le libellé le plus large toutes langues confondues
# (ru "1) Включить Tor (маршрутизация трафика кошелька)" = 48 colonnes).
PAD_OPT = 48    # rubriques de menu (texte + marge avant l'icône)
PAD_LANG = 14   # nom de langue dans le menu Langue (max "中文 (普通话)" = 13)


def _load_module(name, path):
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def load_wm():
    return _load_module("wallet_manager", WALLET_MANAGER)


def load_transfer():
    return _load_module("transfer", TRANSFER)


