def main():
    # Identité visuelle affichée avant toute demande de masterkey.
    from startup_splash import (show_startup_splash, is_first_launch,
                                mark_first_launch_complete)
    first_launch = is_first_launch()
    if not show_startup_splash(first_launch=first_launch):
        print("\n  ◈ CRYPTO COLD WALLET  ·  By Красимир\n")
        if first_launch:
            print("  Welcome to @Красимир_Cold Wallet")
            print("  You are responsible for the assets in your wallet.")
            print("  No one else can control them without your permission.\n")
    if first_launch:
        choose_initial_language()
        mark_first_launch_complete()
    wm = load_wm()
    master_pw = unlock_master()
    while True:
        clear_terminal()
        print("\n" + "=" * 50)
        print("  " + t("menu_title") + "  " + LANG_FLAGS.get(get_lang(), ""))
        print("=" * 50)
        _menu_options = [
            ("opt_create",   "🆕"),   # créer un wallet
            ("opt_balances", "💰"),   # soldes
            ("opt_transfer", "💸"),   # transfert
            ("opt_history",  "📜"),   # historique
            ("opt_exchange", "💱"),   # échange / convertisseur
            ("opt_decrypt",  "🔓"),   # déchiffrer
            ("opt_delete",   "🗑️"),   # supprimer
            ("opt_tor",      "📶"),   # réseau (Tor/Web/couper)
            ("opt_lang",     "🌐"),   # langue
            ("opt_beneficiaries", "📬"),   # destinataires (10)
            ("opt_beta",     "🧪"),   # contact / retours Beta (11)
            ("opt_about",    "ℹ️"),   # à propos (12), juste avant Sortie
            ("opt_debug",    "🛠️"),   # diagnostics / rapport (13)
            ("opt_update",   "🔄"),   # mise à jour (14)
            ("opt_quit",     "🚪"),   # quitter
        ]
        for _key, _icon in _menu_options:
            print("  " + pad_display(t(_key), PAD_OPT) + _icon)
        print("─" * 50)
        choix = input(t("choice_prompt")).strip()
        if choix == "1":
            menu_create(master_pw)
        elif choix == "2":
            menu_show_balances(master_pw)
            input("\n  " + t("about_back"))
        elif choix == "3":
            menu_transfer(master_pw)
        elif choix == "4":
            menu_show_history(master_pw)
        elif choix == "5":
            menu_exchange(master_pw)
        elif choix == "6":
            menu_decrypt(master_pw)
        elif choix == "7":
            menu_delete(master_pw)
        elif choix == "8":
            menu_reseau(master_pw)
        elif choix == "9":
            menu_lang()
        elif choix == "10":
            menu_beneficiaires(master_pw)
        elif choix == "11":
            menu_beta()
        elif choix == "12":
            menu_about()
        elif choix == "13":
            menu_debug(master_pw)
        elif choix == "14":
            menu_update()
        elif choix == "0":
            tor_stop()  # laisse proprement le démon Tor (si actif)
            print("  " + t("bye")); break
        else:
            print("  " + t("invalid_choice"))


def menu_lang():
    """Sous-menu Langue (option 9 du menu principal).
    Permet de changer la langue à tout moment ; le choix est persistant
    (lang.txt) et s'applique immédiatement à tout le menu."""
    # Drapeau unicode associé à chaque code de langue (affiché à droite)
    LANG_FLAGS = {
        "fr": "🇫🇷", "en": "🇬🇧", "es": "🇪🇸", "ru": "🇷🇺",
        "zh": "🇨🇳", "ar": "🇸🇦", "he": "🇮🇱",
        "de": "🇩🇪", "it": "🇮🇹", "pt": "🇵🇹", "ja": "🇯🇵",
        "ko": "🇰🇷", "nl": "🇳🇱", "pl": "🇵🇱", "tr": "🇹🇷",
    }
    while True:
        print("\n" + "─" * 50)
        print("  " + t("lang_title"))
        print("─" * 50)
        for code in LANGS:
            marker = "●" if code == get_lang() else " "
            print(f"  {marker} {code}  {pad_display(LANGS[code], PAD_LANG)} {LANG_FLAGS.get(code, '')}")
        print("─" * 50)
        print("  " + t("lang_current") + LANGS[get_lang()] + f" ({get_lang()})")
        code = input("  " + t("lang_choose")).strip().lower()
        if code == "0":
            return
        if set_lang(code):
            # Réaffiche le message de confirmation dans la NOUVELLE langue
            print("  " + t("lang_set") + LANGS[get_lang()] + f" ({get_lang()}).")
        else:
            print("  " + t("lang_unknown"))


def choose_initial_language():
    flags = {"fr":"🇫🇷","en":"🇬🇧","es":"🇪🇸","ru":"🇷🇺","zh":"🇨🇳","ar":"🇸🇦","he":"🇮🇱","de":"🇩🇪","it":"🇮🇹","pt":"🇵🇹","ja":"🇯🇵","ko":"🇰🇷","nl":"🇳🇱","pl":"🇵🇱","tr":"🇹🇷"}
    print("\n  Choose your language / Choisissez votre langue")
    for idx, code in enumerate(LANGS, 1):
        print(f"  {idx}) {LANGS[code]} {flags.get(code, '')}")
    while True:
        raw = input("  Language: ").strip().lower()
        if raw.isdigit() and 1 <= int(raw) <= len(LANGS):
            raw = list(LANGS)[int(raw) - 1]
        if raw in LANGS:
            set_lang(raw)
            print("  " + t("lang_set") + LANGS[raw] + f" ({raw}).")
            return raw
        print("  Invalid language choice / Choix invalide.")


def menu_beneficiaires(master_pw: str):
    if not access.verify_secondary(master_pw):
        return
    """Sous-menu Bénéficiaires (option 10). Permet de voir, ajouter ou supprimer des destinataires."""
    import beneficiaries_manager as _bm

    def _load_beneficiaries():
        try:
            return _bm.load_beneficiaries(master_pw)
        except Exception as e:
            print("  [!] Carnet chiffré illisible : " + str(e))
            return {}

    def _save_beneficiaries(data):
        try:
            _bm.save_beneficiaries(data, master_pw)
        except Exception as e:
            print("  [!] Erreur sauvegarde chiffrée : " + str(e))

    def _menu_list_destinataires():
        """Affiche tous les destinataires avec numérotation (nom + prénom)."""
        benefs = _load_beneficiaries()
        if not benefs:
            print("  " + t("ben_empty"))
            input("  Appuyez sur Entrée pour continuer...")
            return

        print("\n  " + t("ben_list_title"))
        print("─" * 50)
        for idx, label in enumerate(sorted(benefs.keys()), 1):
            info = benefs[label]
            nom = info.get("nom", "?")
            prenom = info.get("prenom", "?")
            nb_wallets = len(info.get("wallets", []))
            print(f"  {idx}) {label:<25} | {prenom:<10} {nom:<15} | {nb_wallets} wallet(s)")
        print("─" * 50)
        input("  Appuyez sur Entrée pour continuer...")

    def _menu_add_destinataire():
        """Formulaire d'ajout d'un destinataire avec multi-wallet."""
        print("\n  " + t("ben_add"))
        print("─" * 50)

        prenom = input("  " + t("ben_add_prompt_prenom")).strip()
        if not prenom:
            print("  [!] Prénom requis.")
            input("  Appuyez sur Entrée pour continuer...")
            return

        nom = input("  " + t("ben_add_prompt_nom")).strip()
        if not nom:
            print("  [!] Nom requis.")
            input("  Appuyez sur Entrée pour continuer...")
            return

        pseudo = input("  " + t("ben_add_prompt_pseudo")).strip()

        label = f"{prenom} {nom}"
        wallets = []

        add_wallet = input("  Souhaitez-vous ajouter un wallet ? (oui/non) : ").strip().lower()
        if add_wallet not in {"oui", "o", "yes", "y"}:
            wallets = []
        while add_wallet in {"oui", "o", "yes", "y"}:
            print("\n  ── Nouveau wallet ──")
            adresse = input("  " + t("ben_add_prompt_adresse")).strip()
            if not adresse:
                print("  [!] Adresse requise.")
                input("  Appuyez sur Entrée pour continuer...")
                return

            devise = input("  " + t("ben_add_prompt_devise")).strip().upper()
            if not devise:
                print("  [!] Devise requise.")
                input("  Appuyez sur Entrée pour continuer...")
                return

            print("  Réseaux disponibles :")
            networks = list(dict.fromkeys(spec["network"] for spec in ASSETS.values()))
            for number, network in enumerate(networks, 1):
                print(f"    {number}) {network_icon(network)} {network}")
            network_choice = input("  Numéro du réseau : ").strip()
            if not network_choice.isdigit() or not 1 <= int(network_choice) <= len(networks):
                print("  [!] Réseau invalide.")
                return
            reseau = networks[int(network_choice) - 1]

            plateforme = input("  " + t("ben_add_prompt_plateforme")).strip()
            if not plateforme:
                print("  [!] Plateforme requise.")
                input("  Appuyez sur Entrée pour continuer...")
                return

            wallets.append({
                "adresse": adresse,
                "devise": devise,
                "reseau": reseau,
                "plateforme": plateforme,
            })

            print("  " + t("ben_save_success"))

            add_wallet = input("  Ajouter un autre wallet ? (oui/non) : ").strip().lower()

        benefs = _load_beneficiaries()
        benefs[label] = {
            "prenom": prenom,
            "nom": nom,
            "pseudonyme": pseudo,
            "wallets": wallets,
        }
        _save_beneficiaries(benefs)
        print("  ✅ Bénéficiaire sauvegardé : " + label)
        input("  Appuyez sur Entrée pour continuer...")

    def _menu_consulter_beneficiaire(label: str):
        """Affiche tous les wallets enregistrés d'un bénéficiaire."""
        benefs = _load_beneficiaries()
        wallets = benefs.get(label, {}).get("wallets", [])
        print("\n  ── Wallets de " + label + " ──")
        print("─" * 50)
        if wallets:
            for j, w in enumerate(wallets, 1):
                print(f"  {j}) {icon_cell(w['devise'])} {w['devise']:<10} | "
                      f"{pad_display(network_icon(w['reseau']), 2)} {w['reseau']:<8} | "
                      f"{w['adresse'][:40]:<40} | {w['plateforme']}")
        else:
            print("  Aucun wallet enregistré.")
        print("─" * 50)
        input("  Appuyez sur Entrée pour continuer...")

    def _menu_modifier_beneficiaire(label: str):
        """Sous-menu de modification : changer identité, ajouter wallet, supprimer wallet."""
        while True:
            print("\n  " + t("ben_modify_title"))
            print("─" * 50)
            print("  1) " + t("ben_modify_change_identity"))
            print("  2) Wallets")
            print("  3) Supprimer ce bénéficiaire")
            print("  0) " + t("ben_back"))
            print("─" * 50)
            choix = input("  " + t("ben_prompt_choix") + " : ").strip()
            if choix == "1":
                _menu_changer_identite(label)
            elif choix == "2":
                print("  1) Ajouter un wallet enregistré")
                print("  2) Supprimer un wallet enregistré")
                sous = input("  Choix : ").strip()
                if sous == "1":
                    _menu_ajouter_wallet(label)
                elif sous == "2":
                    _menu_supprimer_wallet_par_numero(label)
            elif choix == "3":
                confirm = input(f"  Supprimer définitivement {label} ? (oui/non) : ").strip().lower()
                if confirm in {"oui", "o", "yes", "y"}:
                    benefs = _load_beneficiaries()
                    benefs.pop(label, None)
                    _save_beneficiaries(benefs)
                    print("  ✅ Bénéficiaire supprimé.")
                    return
                print("  Suppression annulée.")
            elif choix == "0":
                return
            else:
                print("  " + t("ben_invalid"))

    def _menu_changer_identite(label: str):
        """Change le prénom et nom d'un bénéficiaire."""
        benefs = _load_beneficiaries()
        info = benefs.get(label)
        if not info:
            print("  [!] Bénéficiaire introuvable.")
            input("  Appuyez sur Entrée pour continuer...")
            return
        print("\n  ── Changer l'identité de " + label + " ──")
        old_prenom = info.get("prenom", "")
        old_nom = info.get("nom", "")
        print("  Prénom actuel : " + old_prenom)
        new_prenom = input("  " + t("ben_add_prompt_prenom")).strip()
        if not new_prenom:
            new_prenom = old_prenom
        print("  Nom actuel : " + old_nom)
        new_nom = input("  " + t("ben_add_prompt_nom")).strip()
        if not new_nom:
            new_nom = old_nom
        new_label = f"{new_prenom} {new_nom}"
        wallets = info.get("wallets", [])
        old_pseudo = info.get("pseudonyme", "")
        new_pseudo = input("  Pseudonyme (laisser vide pour garder '" + old_pseudo + "') : ").strip()
        if not new_pseudo:
            new_pseudo = old_pseudo
        benefs.pop(label)
        benefs[new_label] = {
            "prenom": new_prenom,
            "nom": new_nom,
            "pseudonyme": new_pseudo,
            "wallets": wallets,
        }
        _save_beneficiaries(benefs)
        print("  ✅ Identité mise à jour : " + new_label)
        input("  Appuyez sur Entrée pour continuer...")

    def _menu_ajouter_wallet(label: str):
        """Ajoute un wallet à un bénéficiaire existant (chaîne complète : adresse → réseau → plateforme)."""
        benefs = _load_beneficiaries()
        info = benefs.get(label)
        if not info:
            print("  [!] Bénéficiaire introuvable.")
            input("  Appuyez sur Entrée pour continuer...")
            return
        print("\n  ── Ajouter un wallet à " + label + " ──")
        wallets = info.get("wallets", [])
        print("  " + t("ben_add"))
        print("─" * 50)
        adresse = input("  " + t("ben_add_prompt_adresse")).strip()
        if not adresse:
            print("  [!] Adresse requise.")
            input("  Appuyez sur Entrée pour continuer...")
            return
        devise = input("  " + t("ben_add_prompt_devise")).strip()
        if not devise:
            print("  [!] Devise requise.")
            input("  Appuyez sur Entrée pour continuer...")
            return
        plateforme = input("  " + t("ben_add_prompt_plateforme")).strip()
        if not plateforme:
            print("  [!] Plateforme requise.")
            input("  Appuyez sur Entrée pour continuer...")
            return
        reseau = input("  Réseau (ex: btc, eth, bsc, sol, ltc...) : ").strip().lower()
        wallets.append({
            "adresse": adresse,
            "devise": devise,
            "reseau": reseau,
            "plateforme": plateforme,
        })
        info["wallets"] = wallets
        benefs[label] = info
        _save_beneficiaries(benefs)
        print("  " + t("ben_save_success"))
        print("  ✅ Wallet ajouté à " + label)
        input("  Appuyez sur Entrée pour continuer...")

    def _menu_supprimer_wallet_par_numero(label_override: str = None):
        """Supprime un wallet spécifique d'un bénéficiaire par numéro (avec confirmation y/n).
        Si label_override est fourni, on saute l'étape de choix du bénéficiaire."""
        benefs = _load_beneficiaries()
        if not benefs:
            print("  " + t("ben_empty"))
            input("  Appuyez sur Entrée pour continuer...")
            return

        if label_override:
            labels = [label_override]
        else:
            print("\n  " + t("ben_delete"))
            print("─" * 50)
            for idx, label_item in enumerate(sorted(benefs.keys()), 1):
                info_item = benefs[label_item]
                nom_item = info_item.get("nom", "?")
                prenom_item = info_item.get("prenom", "?")
                nb_item = len(info_item.get("wallets", []))
                print(f"  {idx}) {label_item:<25} | {prenom_item} {nom_item} | {nb_item} wallet(s)")
            print("─" * 50)
            num = input("  Numéro du bénéficiaire : ").strip()
            try:
                idx = int(num) - 1
                if idx < 0 or idx >= len(benefs):
                    print("  [!] Numéro invalide.")
                    input("  Appuyez sur Entrée pour continuer...")
                    return
            except ValueError:
                print("  [!] Numéro invalide (entrez un nombre).")
                input("  Appuyez sur Entrée pour continuer...")
                return
            labels = sorted(benefs.keys())
            label_override = labels[idx]

        label = label_override
        wallets = benefs.get(label, {}).get("wallets", [])

        if not wallets:
            print("  [!] Aucun wallet pour ce bénéficiaire.")
            input("  Appuyez sur Entrée pour continuer...")
            return

        print("\n  ── Wallets de " + label + " ──")
        print("─" * 50)
        for j, w in enumerate(wallets, 1):
            print(f"  {j}) {icon_cell(w['devise'])} {w['devise']:<10} | "
                  f"{pad_display(network_icon(w['reseau']), 2)} {w['reseau']:<8} | "
                  f"{w['adresse'][:40]:<40} | {w['plateforme']}")

        num_w = input("  Numéro du wallet à supprimer : ").strip()
        try:
            idx_w = int(num_w) - 1
            if idx_w < 0 or idx_w >= len(wallets):
                print("  [!] Numéro invalide.")
                input("  Appuyez sur Entrée pour continuer...")
                return
        except ValueError:
            print("  [!] Numéro invalide (entrez un nombre).")
            input("  Appuyez sur Entrée pour continuer...")
            return

        wallet_a_supprimer = wallets[idx_w]
        print("\n  Supprimer ce wallet ?")
        print(f"    Devise : {wallet_a_supprimer['devise']}")
        print(f"    Réseau : {wallet_a_supprimer['reseau']}")
        print(f"    Adresse : {wallet_a_supprimer['adresse']}")
        print(f"    Plateforme : {wallet_a_supprimer['plateforme']}")
        confirm = input("  " + t("ben_delete_confirm")).strip().lower()
        if confirm == "oui" or confirm == "o" or confirm == "y":
            del wallets[idx_w]
            benefs[label]["wallets"] = wallets
            _save_beneficiaries(benefs)
            print("  " + t("ben_delete_done"))
        else:
            print("  Annulé.")

        input("  Appuyez sur Entrée pour continuer...")

    while True:
        print("\n  " + t("ben_title"))
        print("─" * 50)
        print("  1) " + t("ben_add"))
        print("  2) Modifier un destinataire")
        print("  3) " + t("ben_modify_delete_wallet"))
        print("  0) " + t("ben_back"))
        print("─" * 50)
        choix = input("  " + t("ben_prompt_choix") + " : ").strip()

        if choix == "1":
            _menu_add_destinataire()
        elif choix == "2":
            benefs = _load_beneficiaries()
            if not benefs:
                print("  " + t("ben_empty"))
                input("  Appuyez sur Entrée pour continuer...")
                continue
            print("\n  " + t("ben_list_title"))
            print("─" * 50)
            for idx, label in enumerate(sorted(benefs.keys()), 1):
                info = benefs[label]
                nom = info.get("nom", "?")
                prenom = info.get("prenom", "?")
                nb = len(info.get("wallets", []))
                pseudo = info.get("pseudonyme", "")
                print(f"  {idx}) {label:<25} | {prenom} {nom} | {nb} wallet(s)")
            print("─" * 50)
            num = input("  Numéro du bénéficiaire : ").strip()
            try:
                idx = int(num) - 1
                if idx < 0 or idx >= len(benefs):
                    print("  [!] Numéro invalide.")
                    input("  Appuyez sur Entrée pour continuer...")
                    continue
            except ValueError:
                print("  [!] Numéro invalide (entrez un nombre).")
                input("  Appuyez sur Entrée pour continuer...")
                continue
            labels = sorted(benefs.keys())
            label = labels[idx]
            _menu_modifier_beneficiaire(label)
        elif choix == "3":
            # Supprimer un bénéficiaire : numérotation, choix, confirmation, suppression intégrale
            benefs = _load_beneficiaries()
            if not benefs:
                print("  " + t("ben_empty"))
                input("  Appuyez sur Entrée pour continuer...")
                continue
            print("\n  " + t("ben_list_title"))
            print("─" * 50)
            for idx, label in enumerate(sorted(benefs.keys()), 1):
                info = benefs[label]
                nom = info.get("nom", "?")
                prenom = info.get("prenom", "?")
                nb = len(info.get("wallets", []))
                print(f"  {idx}) {label:<25} | {prenom} {nom} | {nb} wallet(s)")
            print("─" * 50)
            num = input("  Numéro du bénéficiaire à supprimer : ").strip()
            try:
                idx = int(num) - 1
                if idx < 0 or idx >= len(benefs):
                    print("  [!] Numéro invalide.")
                    input("  Appuyez sur Entrée pour continuer...")
                    continue
            except ValueError:
                print("  [!] Numéro invalide (entrez un nombre).")
                input("  Appuyez sur Entrée pour continuer...")
                continue
            labels = sorted(benefs.keys())
            label = labels[idx]
            info = benefs[label]
            print("\n  ── Supprimer " + label + " ──")
            print("  Prénom : " + info.get("prenom", ""))
            print("  Nom    : " + info.get("nom", ""))
            print("  Wallets : " + str(len(info.get("wallets", []))))
            for j, w in enumerate(info.get("wallets", []), 1):
                print(f"    {j}) {icon_cell(w['devise'])} {w['devise']:<10} | "
                      f"{pad_display(network_icon(w['reseau']), 2)} {w['reseau']:<8} | "
                      f"{w['adresse'][:40]:<40} | {w['plateforme']}")
            print("─" * 50)
            confirm = input("  " + t("ben_delete_confirm")).strip().lower()
            if confirm == "oui" or confirm == "o" or confirm == "y":
                del benefs[label]
                _save_beneficiaries(benefs)
                print("  " + t("ben_delete_done"))
            else:
                print("  Annulé.")
            input("  Appuyez sur Entrée pour continuer...")
        elif choix == "0":
            return
        else:
            print("  " + t("ben_invalid"))
if __name__ == "__main__":
    main()
