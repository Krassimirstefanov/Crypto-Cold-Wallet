def menu_debug(master_pw: str):
    """Diagnostics locales et génération d'un rapport transmissible manuellement."""
    import datetime
    import secrets
    while True:
        print("\n  DEBUG / RAPPORT")
        print("  1) Vérifier les fichiers chiffrés")
        print("  2) Générer un rapport")
        print("  0) Retour")
        choice = input("  Choix : ").strip()
        if choice == "1":
            for path in (BASE / "wallets" / "wallets.enc", BASE / "beneficiaries.enc",
                         BASE / "historique" / "transactions.log.enc"):
                state = "présent" if path.exists() else "absent (normal si inutilisé)"
                print(f"  {path.name}: {state}")
            input("  Entrée pour continuer...")
        elif choice == "2":
            report_id = secrets.token_hex(6).upper()
            subject = f"Crypto Cold Wallet - Report {report_id}"
            body = (f"Report ID: {report_id}\n"
                    f"Date: {datetime.datetime.now(datetime.timezone.utc).isoformat()}\n"
                    "Describe the issue here. Do not include passwords, seeds or private keys.\n")
            print("\n  Rapport généré.")
            print(f"  ID : {report_id}")
            print(f"  Objet à utiliser : {subject}")
            print("  Copiez ce texte et envoyez-le manuellement à votre adresse de support.")
            print("\n" + body)
            input("  Entrée pour continuer...")
        elif choice == "0":
            return
        else:
            print("  Choix invalide.")


