#!/usr/bin/env python3
"""
menu.py — Interface interactive principale du gestionnaire de wallets crypto locaux.
Orchestre : création, liste/balances, transfert (en $ ou crypto, conversion marché),
et décryptage (un wallet ou tous).

Usage :
    python menu.py
Le script compile/importe wallet_manager.py et transfer.py (présents dans le dossier).
"""

import importlib.util
import json
import os
import random
import shutil
import socket
import string
import subprocess
import sys
import time
from pathlib import Path
from getpass import getpass as _getpass

# ─────────────────── Virtual environment bootstrap ───────────────────
# menu.py may be launched with the system Python (python3 menu.py, ./menu.py,
# an alias, Bash, Zsh, Termux, etc.). Before importing any project module,
# automatically restart this process with the Python interpreter from .venv.
#
# This is intentionally placed BEFORE imports such as i18n / transfer /
# wallet_manager, because those modules depend on packages installed in .venv.

_PROJECT_DIR = Path(__file__).resolve().parent
_VENV_DIR = _PROJECT_DIR / ".venv"

if os.name == "nt":
    _VENV_PYTHON = _VENV_DIR / "Scripts" / "python.exe"
else:
    _VENV_PYTHON = _VENV_DIR / "bin" / "python"

try:
    _USING_PROJECT_VENV = Path(sys.prefix).resolve() == _VENV_DIR.resolve()
except OSError:
    _USING_PROJECT_VENV = False

if not _USING_PROJECT_VENV:
    if not _VENV_PYTHON.is_file():
        print(
            "[!] Environnement virtuel .venv introuvable.\n"
            f"    Chemin attendu : {_VENV_PYTHON}\n"
            "    Lance d'abord : ./install.sh",
            file=sys.stderr,
        )
        raise SystemExit(1)

    if not os.access(_VENV_PYTHON, os.X_OK):
        print(
            "[!] Le Python de .venv existe mais n'est pas exécutable :\n"
            f"    {_VENV_PYTHON}",
            file=sys.stderr,
        )
        raise SystemExit(1)

    # Replace the current process. sys.argv is preserved, including options
    # passed to menu.py. This works from Bash, Zsh, sh and Termux because the
    # shell is no longer involved after Python has started.
    os.execv(
        str(_VENV_PYTHON),
        [str(_VENV_PYTHON), str(Path(__file__).resolve()), *sys.argv[1:]],
    )
